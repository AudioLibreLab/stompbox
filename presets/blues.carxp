<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE CARLA-PROJECT>
<CARLA-PROJECT VERSION='2.5'>
 <EngineSettings>
  <ForceStereo>false</ForceStereo>
  <PreferPluginBridges>false</PreferPluginBridges>
  <PreferUiBridges>true</PreferUiBridges>
  <UIsAlwaysOnTop>false</UIsAlwaysOnTop>
  <MaxParameters>200</MaxParameters>
  <UIBridgesTimeout>4000</UIBridgesTimeout>
 </EngineSettings>

 <Transport>
  <BeatsPerMinute>120</BeatsPerMinute>
 </Transport>

 <!-- GxTubeScreamer -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>Gxts9sim</Name>
   <URI>http://guitarix.sourceforge.net/plugins/gxts9#ts9sim</URI>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x0</Options>

   <Parameter>
    <Index>0</Index>
    <Name>Level</Name>
    <Symbol>fslider0_</Symbol>
    <Value>-16</Value>
   </Parameter>

   <Parameter>
    <Index>1</Index>
    <Name>Tone</Name>
    <Symbol>fslider1_</Symbol>
    <Value>400</Value>
   </Parameter>

   <Parameter>
    <Index>2</Index>
    <Name>Drive</Name>
    <Symbol>fslider2_</Symbol>
    <Value>0.5</Value>
   </Parameter>

   <Parameter>
    <Index>3</Index>
    <Name>BYPASS</Name>
    <Symbol>BYPASS</Symbol>
    <Value>1</Value>
   </Parameter>
  </Data>
 </Plugin>

 <!-- Ratatouille -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>Ratatouille</Name>
   <URI>urn:brummer:ratatouille</URI>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x1</Options>

   <Parameter>
    <Index>0</Index>
    <Name>input</Name>
    <Symbol>Knob0</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>1</Index>
    <Name>output</Name>
    <Symbol>Knob1</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>2</Index>
    <Name>blend</Name>
    <Symbol>Knob2</Symbol>
    <Value>0.5</Value>
   </Parameter>

   <Parameter>
    <Index>3</Index>
    <Name>mix</Name>
    <Symbol>Knob3</Symbol>
    <Value>0.5</Value>
   </Parameter>

   <Parameter>
    <Index>4</Index>
    <Name>Delay</Name>
    <Symbol>Knob4</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>5</Index>
    <Name>Normalize A</Name>
    <Symbol>NormalizeA</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>6</Index>
    <Name>Normalize B</Name>
    <Symbol>NormalizeB</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>7</Index>
    <Name>input1</Name>
    <Symbol>Knob5</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>8</Index>
    <Name>Normalize Slot A</Name>
    <Symbol>NormalizeSlotA</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>9</Index>
    <Name>Normalize Slot B</Name>
    <Symbol>NormalizeSlotB</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>10</Index>
    <Name>enable</Name>
    <Symbol>ENABLE</Symbol>
    <Value>1</Value>
   </Parameter>

   <Parameter>
    <Index>11</Index>
    <Name>erase Slot A</Name>
    <Symbol>eraseSlotA</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>12</Index>
    <Name>erase Slot B</Name>
    <Symbol>eraseSlotB</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>13</Index>
    <Name>erase Ir</Name>
    <Symbol>eraseIr</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>14</Index>
    <Name>erase Ir1</Name>
    <Symbol>eraseIr1</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>16</Index>
    <Name>Buffered</Name>
    <Symbol>buffered</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>17</Index>
    <Name>Phase Correction</Name>
    <Symbol>phase</Symbol>
    <Value>0</Value>
   </Parameter>

   <CustomData>
    <Type>http://lv2plug.in/ns/ext/atom#Path</Type>
    <Key>urn:brummer:ratatouille#Neural_Model</Key>
    <Value>/home/fjammes/Music/NAM/AmpHead/amalgam MRSH JT100 I Crunch BAL DI.nam</Value>
   </CustomData>

   <CustomData>
    <Type>http://lv2plug.in/ns/ext/atom#Path</Type>
    <Key>urn:brummer:ratatouille#irfile</Key>
    <Value>/home/fjammes/Music/IRs/guitar/Marshall JCM2000 SM57.wav</Value>
   </CustomData>

   <CustomData>
    <Type>http://lv2plug.in/ns/ext/atom#String</Type>
    <Key>urn:brummer:ratatouille#Neural_Model1</Key>
    <Value>None</Value>
   </CustomData>

   <CustomData>
    <Type>http://lv2plug.in/ns/ext/atom#String</Type>
    <Key>urn:brummer:ratatouille#irfile1</Key>
    <Value>None</Value>
   </CustomData>
  </Data>
 </Plugin>

 <!-- Calf Equalizer 8 Band -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>Calf Equalizer 8 Band</Name>
   <URI>http://calf.sourceforge.net/plugins/Equalizer8Band</URI>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x3f1</Options>

   <Parameter>
    <Index>0</Index>
