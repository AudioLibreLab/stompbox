# Generated by stompbox — DO NOT EDIT.
[Unit]
Description=SooperLooper engine instance "%i" (stompbox)
# Headless engine: no BindsTo=graphical-session.target,
# the UI (slgui) is a throwaway client launched via "stomp ui".
After=pipewire.service
StopWhenUnneeded=yes

[Service]
Type=simple
EnvironmentFile=%h/.config/stompbox/sooperlooper/%i.env
# -j sl_%i: deterministic JACK client name, required for the
# qpwgraph patchbay to apply reliably.
# pw-jack: the system libjack is JACK2's (without jackd);
# it redirects to PipeWire's libjack.
ExecStart=/usr/bin/pw-jack /usr/bin/sooperlooper -q -j sl_%i -p $SL_OSC_PORT -l $SL_LOOPS -c $SL_CHANNELS -t $SL_LOOPTIME $SL_EXTRA_ARGS
Restart=on-failure
RestartSec=2
