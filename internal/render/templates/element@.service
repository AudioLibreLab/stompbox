# Generated by stompbox — DO NOT EDIT.
[Unit]
Description=Element instance "%i" (stompbox)
# Element has no headless/no-gui mode: its window is the UI, like
# qpwgraph and Hydrogen, so it's bound to the graphical session.
After=pipewire.service graphical-session.target
BindsTo=graphical-session.target
StopWhenUnneeded=yes
# Restart=always with no limit: closing the window brings it back,
# only "stomp off" turns the pedalboard off.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/stompbox/element/%i.env
# pw-jack: the system libjack is JACK2's (without jackd);
# it redirects to PipeWire's libjack.
ExecStart=/usr/bin/pw-jack /usr/bin/element ${ELEMENT_SESSION}
Restart=always
RestartSec=2
