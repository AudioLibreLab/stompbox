# Generated by stompbox — DO NOT EDIT.
[Unit]
Description=Carla instance "%i" (stompbox)
# GUI host: needed to show plugin native UIs (Ratatouille, NAM, Calf...),
# which carla-control (OSC remote) cannot display.
After=pipewire.service graphical-session.target
BindsTo=graphical-session.target
# Requires= doesn't propagate stop: this flag is what makes
# "stomp off" (stopping the target) actually stop the instance.
StopWhenUnneeded=yes
# Restart=always with no limit: only "stomp off" turns the pedalboard off.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/stompbox/carla/%i.env
# pw-jack: the system libjack is JACK2's (without jackd);
# it redirects to PipeWire's libjack.
ExecStart=/usr/bin/pw-jack /usr/bin/carla ${CARLA_PRESET}
Restart=always
RestartSec=2
